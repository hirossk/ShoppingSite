<%
// ============================================================
//  商品カード（共通パーツ）
//  ★このファイルを直すと、Step3・Step4・本番ショップ(/shop)・
//    トップpage(/) の商品カードが「すべて同時に」変わります。
//
//  受け取る値：
//    item      … 1つの商品（name / price / image / stock / code）
//    showCart  … true なら「カートに入れる」ボタンを出す
//    addUrl    … ボタンの行き先（例 '/cart/add' や '/shop/add'）
// ============================================================
%>
<div class="col">
    <div class="card h-100 shadow-sm">
        <!-- 商品画像（大きく表示） -->
        <img class="card-img-top" src="/images/<%= item.image %>.png"
             alt="<%= item.name %>" style="height:180px; object-fit:contain; padding:8px;">
        <!-- 商品情報 -->
        <div class="card-body p-3 text-center">
            <h5 class="card-title fw-bold mb-1"><%= item.name %></h5>
            <p class="card-text text-primary fs-5 fw-bold mb-1">
                ¥<%= item.price.toLocaleString() %>
            </p>
            <p class="card-text small text-muted mb-0">
                <% if (item.stock > 0) { %>
                <span class="badge bg-success">在庫 <%= item.stock %> 個</span>
                <% } else { %>
                <span class="badge bg-danger">売り切れ</span>
                <% } %>
            </p>
        </div>
        <% if (showCart) { %>
        <!-- カートボタン（addUrl + 商品番号 にリンク） -->
        <div class="card-footer bg-transparent border-top p-3 text-center">
            <% if (item.stock > 0) { %>
            <a href="<%= addUrl %>/<%= item.code %>" class="btn btn-primary w-100">
                <i class="bi bi-cart-plus me-1"></i>カートに入れる
            </a>
            <% } else { %>
            <button class="btn btn-secondary w-100" disabled>
                <i class="bi bi-x-circle me-1"></i>売り切れ
            </button>
            <% } %>
        </div>
        <% } %>
    </div>
</div>
