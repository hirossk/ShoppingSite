<%- include('partials/header') %>

<!-- ============================================================ -->
<!--  ショップ（商品一覧）— 完成版のお店                          -->
<!-- ============================================================ -->
<section class="py-4">
<div class="container mt-3">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0"><i class="bi bi-shop me-2"></i>商品一覧</h2>
        <a href="/cart" class="btn btn-outline-danger">
            <i class="bi bi-cart me-1"></i>カートを見る
        </a>
    </div>

    <% if (itemlist.length === 0) { %>
    <div class="text-center p-5 text-muted">
        商品がまだありません。
    </div>
    <% } else { %>
    <div class="row gx-4 gy-4 row-cols-2 row-cols-md-3 row-cols-xl-4">
        <% itemlist.forEach(function(item) { %>
        <%- include('partials/product_card', { item: item, showCart: true, addUrl: '/shop/add' }) %>
        <% }) %>
    </div>
    <% } %>

</div>
</section>

<%- include('partials/footer') %>
