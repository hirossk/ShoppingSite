<%- include('partials/header') %>

<section class="py-4">
<div class="container mt-4">

    <!-- Step ヘッダー -->
    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-dark fs-5 me-3">Step 6</span>
        <h2 class="mb-0">購入完了・在庫確認　<small class="text-muted fs-6">〜データベースが変わったのを確認しよう〜</small></h2>
    </div>

    <div class="alert alert-dark small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>ポイント：</strong> 購入すると <code>item</code> テーブルの <code>stock</code>（在庫数）が減ります。
        「在庫確認テーブル」で実際に変わったかどうか確認しましょう！
        これがデータベースを使った「状態管理」の基本です。
    </div>

    <% if (order.items && order.items.length > 0) { %>
    <!-- 購入完了メッセージ -->
    <div class="card border-success shadow mb-4">
        <div class="card-body text-center py-4">
            <div class="display-1 mb-2">🎉</div>
            <h3 class="text-success fw-bold">購入が完了しました！</h3>
            <p class="text-muted">ご注文ありがとうございました。</p>
        </div>
    </div>

    <!-- 購入明細（共通パーツ：本番 /complete と同じものを使用） -->
    <%- include('partials/order_table', { order: order }) %>
    <% } else { %>
    <div class="alert alert-secondary">
        <i class="bi bi-info-circle me-1"></i>
        まだ購入していません。Step 5 で購入すると、ここに明細が表示されます。
    </div>
    <% } %>

    <!-- 在庫確認テーブル -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-database me-2"></i>現在の在庫確認（item テーブル）
        </div>
        <div class="card-body p-0">
            <%- include('partials/stock_table', { itemlist: itemlist }) %>
        </div>
    </div>

    <!-- ナビ -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/step5" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Step 5 カート
        </a>
        <a href="/step4" class="btn btn-warning">
            <i class="bi bi-shop-window me-1"></i>もう一度ショッピングする
        </a>
        <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>Homeへ戻る
        </a>
    </div>

</div>
</section>

<%- include('partials/footer') %>
