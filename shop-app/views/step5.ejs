<%- include('partials/header') %>

<section class="py-4">
<div class="container mt-4">

    <!-- Step ヘッダー -->
    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-danger fs-5 me-3">Step 5</span>
        <h2 class="mb-0">カート確認・購入　<small class="text-muted fs-6">〜合計金額を出して注文しよう〜</small></h2>
    </div>

    <div class="alert alert-danger small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>ポイント：</strong> カートの表は共通パーツ
        <code>views/partials/cart_table.ejs</code> に書かれています（小計 ＝ 数量 × 価格 もここ）。
        ここを直すと <strong>本番ショップのカート(/cart) も同時に変わります</strong>。
        「購入する」ボタンで <code>POST /purchase</code> を呼び出します。
    </div>

    <!-- エラーメッセージ -->
    <% if (errorMsg) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ <%= errorMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (cartlist.length === 0) { %>
    <!-- カートが空 -->
    <div class="card text-center p-5 shadow-sm">
        <div class="card-body">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">カートが空です</h4>
            <p class="text-muted">Step 4 のショップから商品をカートに入れてください。</p>
            <a href="/step4" class="btn btn-warning mt-2">
                <i class="bi bi-shop-window me-1"></i>ショップに戻る
            </a>
        </div>
    </div>
    <% } else { %>

    <!-- カート内容テーブル（共通パーツ：本番 /cart と同じものを使用） -->
    <%- include('partials/cart_table', { cartlist: cartlist, total: total, removeUrl: '/cart/del' }) %>

    <!-- 購入ボタン -->
    <div class="text-center">
        <form action="/purchase" method="POST">
            <button type="submit" class="btn btn-danger btn-lg px-5"
                    onclick="return confirm('合計 <%= total.toLocaleString() %>円 で購入しますか？')">
                <i class="bi bi-bag-check me-2"></i>購入する（合計 <%= total.toLocaleString() %>円）
            </button>
        </form>
        <div class="mt-2">
            <a href="/step4" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>ショップに戻る
            </a>
        </div>
    </div>

    <% } %>

    <!-- ナビ -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/step4" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Step 4 ショップ
        </a>
        <a href="/step6" class="btn btn-dark">
            Step 6 購入完了・在庫確認 <i class="bi bi-arrow-right"></i>
        </a>
    </div>

</div>
</section>

<%- include('partials/footer') %>
