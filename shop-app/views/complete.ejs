<%- include('partials/header') %>

<!-- ============================================================ -->
<!--  購入完了・在庫確認 — 完成版のお店                          -->
<!-- ============================================================ -->
<section class="py-4">
<div class="container mt-3">

    <% if (order.items && order.items.length > 0) { %>
    <!-- 購入完了メッセージ -->
    <div class="card border-success shadow mb-4">
        <div class="card-body text-center py-4">
            <div class="display-1 mb-2">🎉</div>
            <h3 class="text-success fw-bold">ご購入ありがとうございました！</h3>
            <p class="text-muted">ご注文を承りました。</p>
        </div>
    </div>

    <!-- 購入明細（共通パーツ：Step6 と同じものを使用） -->
    <%- include('partials/order_table', { order: order }) %>
    <% } else { %>
    <div class="alert alert-secondary">
        <i class="bi bi-info-circle me-1"></i>
        まだ購入していません。<a href="/shop">ショップ</a>から商品を選んでください。
    </div>
    <% } %>

    <!-- 現在の在庫 -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-database me-2"></i>現在の在庫
        </div>
        <div class="card-body p-0">
            <%- include('partials/stock_table', { itemlist: itemlist }) %>
        </div>
    </div>

    <!-- ナビ -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/shop" class="btn btn-warning">
            <i class="bi bi-shop me-1"></i>もう一度買い物する
        </a>
        <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>トップへ戻る
        </a>
    </div>

</div>
</section>

<%- include('partials/footer') %>
