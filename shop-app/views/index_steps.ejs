<%- include('partials/header') %>

<!-- ヒーローバナー -->
<header class="py-1">
    <div class="container px-lg-1">
        <div class="p-4 p-lg-5 bg-light rounded-3 text-center">
            <div class="m-4 my-lg-0">
                <h1 class="display-5 fw-bold">🛠️ ショッピングサイトを作ろう！（制作ステップ）</h1>
                <p class="fs-5">Step 1〜6 の順番で進めてみましょう。<br>
                   商品データを入力して、カートに入れて、購入するまでの流れを体験します。</p>
                <a href="/" class="btn btn-outline-dark mt-2">
                    <i class="bi bi-house me-1"></i>完成したお店のトップへ戻る
                </a>
            </div>
        </div>
    </div>
</header>

<!-- Step カード一覧 -->
<section class="pt-4 pb-5">
    <div class="container px-lg-5">
        <div class="row gx-lg-4 row-cols-1 row-cols-md-2 row-cols-xl-3">

            <!-- Step 1 -->
            <div class="col mb-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white fw-bold">
                        <i class="bi bi-1-circle-fill me-2"></i>Step 1　データエントリー
                    </div>
                    <div class="card-body">
                        <p class="card-text">商品名・価格・画像を入力して、データベースに商品を追加してみましょう。</p>
                        <ul class="small text-muted">
                            <li>フォームに値を入力する</li>
                            <li>「追加する」ボタンを押す</li>
                            <li>一覧に追加されるのを確認</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a href="/step1" class="btn btn-primary w-100">
                            <i class="bi bi-database-add me-1"></i>Step 1 へ進む
                        </a>
                    </div>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col mb-4">
                <div class="card h-100 border-success">
                    <div class="card-header bg-success text-white fw-bold">
                        <i class="bi bi-2-circle-fill me-2"></i>Step 2　一覧表示（テーブル）
                    </div>
                    <div class="card-body">
                        <p class="card-text">追加した商品をテーブル形式で表示します。画像も一緒に確認できます。</p>
                        <ul class="small text-muted">
                            <li>DBのデータを読み込む</li>
                            <li>テーブルで表示する</li>
                            <li>画像を表示する</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a href="/step2" class="btn btn-success w-100">
                            <i class="bi bi-table me-1"></i>Step 2 へ進む
                        </a>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col mb-4">
                <div class="card h-100 border-info">
                    <div class="card-header bg-info text-white fw-bold">
                        <i class="bi bi-3-circle-fill me-2"></i>Step 3　カード形式で表示
                    </div>
                    <div class="card-body">
                        <p class="card-text">商品を大きな画像のカード形式で並べてみましょう。ショッピングサイトらしくなります！</p>
                        <ul class="small text-muted">
                            <li>カードレイアウトを使う</li>
                            <li>画像を大きく表示する</li>
                            <li>価格を見やすく表示</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a href="/step3" class="btn btn-info text-white w-100">
                            <i class="bi bi-grid me-1"></i>Step 3 へ進む
                        </a>
                    </div>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="col mb-4">
                <div class="card h-100 border-warning">
                    <div class="card-header bg-warning fw-bold">
                        <i class="bi bi-4-circle-fill me-2"></i>Step 4　ショップ（カートに入れる）
                    </div>
                    <div class="card-body">
                        <p class="card-text">「カートに入れる」ボタンを追加して、本物のショッピングサイトみたいにしましょう！</p>
                        <ul class="small text-muted">
                            <li>ボタンにリンクを貼る</li>
                            <li>クリックでカートへ追加</li>
                            <li>在庫数も表示</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a href="/step4" class="btn btn-warning w-100">
                            <i class="bi bi-shop-window me-1"></i>Step 4 へ進む
                        </a>
                    </div>
                </div>
            </div>

            <!-- Step 5 -->
            <div class="col mb-4">
                <div class="card h-100 border-danger">
                    <div class="card-header bg-danger text-white fw-bold">
                        <i class="bi bi-5-circle-fill me-2"></i>Step 5　カート・購入
                    </div>
                    <div class="card-body">
                        <p class="card-text">カートの中身を確認して、合計金額を表示します。「購入する」ボタンで注文完了！</p>
                        <ul class="small text-muted">
                            <li>カート内の商品一覧を表示</li>
                            <li>合計金額を計算</li>
                            <li>「購入する」ボタン</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a href="/step5" class="btn btn-danger w-100">
                            <i class="bi bi-cart-check me-1"></i>Step 5 へ進む
                        </a>
                    </div>
                </div>
            </div>

            <!-- Step 6 -->
            <div class="col mb-4">
                <div class="card h-100 border-dark">
                    <div class="card-header bg-dark text-white fw-bold">
                        <i class="bi bi-6-circle-fill me-2"></i>Step 6　購入完了・在庫確認
                    </div>
                    <div class="card-body">
                        <p class="card-text">購入が完了すると、在庫数が減ります。データベースの変化を確認してみましょう！</p>
                        <ul class="small text-muted">
                            <li>購入完了メッセージ</li>
                            <li>購入した商品の明細</li>
                            <li>在庫が減っているか確認</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a href="/step6" class="btn btn-dark w-100">
                            <i class="bi bi-bag-check me-1"></i>Step 6 へ進む
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<%- include('partials/footer') %>
