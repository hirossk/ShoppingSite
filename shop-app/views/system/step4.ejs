<%- include('../partials/header') %>

<section class="py-4">
<div class="container mt-4">

    <!-- Step ヘッダー -->
    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-danger fs-5 me-3">Step 4</span>
        <h2 class="mb-0">購入する　<small class="text-muted fs-6">〜カートを確認して買う・買うと在庫が減る〜</small></h2>
    </div>

    <div class="alert alert-danger small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>ポイント：</strong> カートの表は共通パーツ
        <code>views/partials/cart_table.ejs</code> に書かれています（小計 ＝ 数量 × 価格 もここ）。
        ここを直すと <strong>本番ショップのカート(/cart) も同時に変わります</strong>。
        「購入する」ボタンで <code>POST /purchase</code> を呼び出すと、買った分だけ
        <strong>商品の在庫（stock）が減って</strong>、購入完了（Step5）に進みます。
    </div>

    <!-- エラーメッセージ -->
    <% if (errorMsg) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ <%= errorMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (cartlist.length === 0) { %>
    <!-- カートが空 -->
    <div class="card text-center p-5 shadow-sm">
        <div class="card-body">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">カートが空です</h4>
            <p class="text-muted">Step 3 から商品をカートに入れてください。</p>
            <a href="/step3" class="btn btn-warning mt-2">
                <i class="bi bi-shop-window me-1"></i>商品をえらぶ（Step 3）
            </a>
        </div>
    </div>
    <% } else { %>

    <!-- カート内容テーブル（共通パーツ：本番 /cart と同じものを使用） -->
    <%- include('../partials/cart_table', { cartlist: cartlist, total: total, removeurl: '/cart/del' }) %>

    <!-- 購入ボタン（共通パーツ：本番 /cart と同じものを使用） -->
    <%- include('../partials/buy_button', { buyurl: '/purchase', total: total }) %>
    <div class="text-center mt-2">
        <a href="/step3" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>買い物を続ける（Step 3）
        </a>
    </div>

    <% } %>

    <!-- ナビ -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/step3" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Step 3 カートに入れる
        </a>
        <a href="/step5" class="btn btn-dark">
            Step 5 購入完了画面 <i class="bi bi-arrow-right"></i>
        </a>
    </div>

</div>
</section>

<%- include('../partials/footer') %>
