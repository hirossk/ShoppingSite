<%- include('../mikansei/header') %>

<section class="py-4">
<div class="container mt-4">

    <!-- Step ヘッダー -->
    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-dark fs-5 me-3">Step 5</span>
        <h2 class="mb-0">購入完了画面　<small class="text-muted fs-6">〜「ご購入ありがとう」の画面を作ろう〜</small></h2>
    </div>

    <div class="alert alert-dark small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>ポイント：</strong> 購入明細は共通パーツ
        <code>views/mikansei/order_table.ejs</code> に書かれています。ここを直すと
        <strong>本番ショップの購入完了(/complete) も同時に変わります</strong>。
        買った分だけ在庫が減ったかは、<a href="/step2">Step 2</a> のカードの「在庫◯個」で確認できます。
    </div>

    <% if (order.items && order.items.length > 0) { %>
    <!-- 購入完了メッセージ -->
    <div class="card border-success shadow mb-4">
        <div class="card-body text-center py-4">
            <div class="display-1 mb-2">🎉</div>
            <h3 class="text-success fw-bold">購入が完了しました！</h3>
            <p class="text-muted">ご注文ありがとうございました。</p>
        </div>
    </div>

    <!-- 購入明細（共通パーツ：本番 /complete と同じものを使用） -->
    <%- include('../mikansei/order_table', { order: order }) %>
    <% } else { %>
    <div class="alert alert-secondary">
        <i class="bi bi-info-circle me-1"></i>
        まだ購入していません。<a href="/step4">Step 4</a> で購入すると、ここに明細が表示されます。
    </div>
    <% } %>

    <!-- ナビ -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/step4" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Step 4 購入する
        </a>
        <a href="/step3" class="btn btn-warning">
            <i class="bi bi-shop-window me-1"></i>もう一度ショッピングする
        </a>
        <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>Homeへ戻る
        </a>
    </div>

</div>
</section>

<%- include('../mikansei/footer') %>
