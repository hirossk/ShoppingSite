<%- include('../mikansei/header') %>

<section class="py-4">
<div class="container mt-4">

    <!-- Step ヘッダー -->
    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-success fs-5 me-3">Step 2</span>
        <h2 class="mb-0">カード型で表示　<small class="text-muted fs-6">〜商品をおしゃれに並べて、詳細ページも作ろう〜</small></h2>
    </div>

    <div class="alert alert-success small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>ポイント：</strong> 商品カードの中身は共通パーツ
        <code>views/mikansei/product_card.ejs</code> に書かれています。画像・商品名・価格・在庫を表示し、
        「詳細を見る」を押すと <strong>商品詳細ページ（<code>/item/番号</code>）</strong>が開きます。
        ここを直すと、この Step2 だけでなく <strong>本番ショップ(/shop) のカードも同時に変わります</strong>！
    </div>

    <% if (itemlist.length === 0) { %>
    <div class="text-center p-5 text-muted">
        商品がまだありません。<a href="/step1">Step 1</a> で商品を追加してください。
    </div>
    <% } else { %>
    <div class="row gx-4 gy-4 row-cols-2 row-cols-md-3 row-cols-xl-4">
        <% itemlist.forEach(function(item) { %>
        <%- include('../mikansei/product_card', { item: item, showCart: false, addurl: '', showDetail: true }) %>
        <% }) %>
    </div>
    <% } %>

    <!-- ナビ -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/step1" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Step 1 商品登録
        </a>
        <a href="/step3" class="btn btn-warning">
            次へ：Step 3 カートに入れる <i class="bi bi-arrow-right"></i>
        </a>
    </div>

</div>
</section>

<%- include('../mikansei/footer') %>
