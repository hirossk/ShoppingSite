<%- include('../partials/header') %>

<section class="py-4">
<div class="container mt-4">

    <!-- Step ヘッダー -->
    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-primary fs-5 me-3">Step 1</span>
        <h2 class="mb-0">商品登録　<small class="text-muted fs-6">〜お店に並べる商品をデータベースに登録しよう〜</small></h2>
    </div>

    <!-- メッセージ -->
    <% if (message === 'added') { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ 商品を追加しました！
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } else if (message === 'deleted') { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        🗑️ 商品を削除しました。
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } else if (message === 'error_empty') { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ 商品名・価格・画像をすべて入力してください。
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } else if (message === 'error_price') { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ 価格は1以上の整数を入力してください。
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <div class="row g-4">

        <!-- 左：入力フォーム -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-plus-circle me-2"></i>新しい商品を追加する
                </div>
                <div class="card-body">
                    <!-- POST で /step1 へ送信 -->
                    <form action="/step1" method="POST">

                        <!-- 商品名 -->
                        <div class="mb-3">
                            <label for="name" class="form-label fw-bold">商品名</label>
                            <input type="text" class="form-control" id="name" name="name"
                                   placeholder="例：ノートパソコン" maxlength="50" required>
                        </div>

                        <!-- 価格 -->
                        <div class="mb-3">
                            <label for="price" class="form-label fw-bold">価格（円）</label>
                            <input type="number" class="form-control" id="price" name="price"
                                   placeholder="例：98000" min="1" max="9999999" required>
                        </div>

                        <!-- 画像選択 -->
                        <div class="mb-3">
                            <label for="image" class="form-label fw-bold">画像を選ぶ</label>
                            <select class="form-select" id="image" name="image" required
                                    onchange="previewImage(this.value)">
                                <option value="">--- 選んでください ---</option>
                                <% imageList.forEach(function(img) { %>
                                <option value="<%= img %>"><%= img %></option>
                                <% }) %>
                            </select>
                            <!-- プレビュー -->
                            <div class="mt-2 text-center" id="imagePreview">
                                <img id="previewImg" src="" alt="" width="120" height="96"
                                     style="display:none; border:1px solid #ddd; border-radius:4px;">
                            </div>
                        </div>

                        <!-- 商品説明（商品詳細ページに表示される。なくてもOK） -->
                        <div class="mb-3">
                            <label for="description" class="form-label fw-bold">商品説明 <span class="text-muted small">（任意）</span></label>
                            <textarea class="form-control" id="description" name="description" rows="3"
                                      placeholder="例：初心者にもやさしいギターです。" maxlength="300"></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-database-add me-2"></i>追加する
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 右：現在の商品一覧 -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-list-ul me-2"></i>現在の商品一覧（データベースの中身）
                </div>
                <div class="card-body p-0">
                    <% if (itemlist.length === 0) { %>
                    <p class="text-muted text-center p-4">まだ商品がありません。左のフォームから追加してみよう！</p>
                    <% } else { %>
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>コード</th>
                                <th>画像</th>
                                <th>商品名</th>
                                <th>価格</th>
                                <th>在庫</th>
                                <th>削除</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% itemlist.forEach(function(item) { %>
                            <tr>
                                <td><%= item.code %></td>
                                <td>
                                    <img src="/images/<%= item.image %>.png"
                                         width="60" height="48" alt="<%= item.image %>">
                                </td>
                                <td><%= item.name %></td>
                                <td><%= item.price.toLocaleString() %>円</td>
                                <td><span class="badge bg-success"><%= item.stock %>個</span></td>
                                <td>
                                    <form action="/step1/delete" method="POST"
                                          onsubmit="return confirm('<%= item.name %> を削除しますか？')">
                                        <input type="hidden" name="code" value="<%= item.code %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <% } %>
                </div>
                <div class="card-footer text-muted small">
                    商品数：<%= itemlist.length %> 件
                </div>
            </div>
        </div>
    </div>

    <!-- ナビ -->
    <div class="d-flex justify-content-between mt-4">
        <a href="/" class="btn btn-outline-secondary">
            <i class="bi bi-house me-1"></i>Homeへ
        </a>
        <a href="/step2" class="btn btn-success">
            次へ：Step 2 カード表示・詳細 <i class="bi bi-arrow-right"></i>
        </a>
    </div>

</div>
</section>

<script>
function previewImage(imageName) {
    const img = document.getElementById('previewImg');
    if (imageName) {
        img.src = '/images/' + imageName + '.png';
        img.alt = imageName;
        img.style.display = 'inline';
    } else {
        img.style.display = 'none';
    }
}
</script>

<%- include('../partials/footer') %>
