<%- include('../mikansei/header') %>

<!-- ============================================================ -->
<!--  商品詳細ページ — 完成版のお店                              -->
<!-- ============================================================ -->
<section class="py-4">
<div class="container mt-3">

    <div class="mb-3">
        <a href="/shop" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>商品一覧へ戻る
        </a>
    </div>

    <% if (!item) { %>
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-1"></i>
        その商品は見つかりませんでした。<a href="/shop">商品一覧</a>から選びなおしてください。
    </div>
    <% } else { %>
    <%- include('../mikansei/item_detail', { item: item, addurl: addurl }) %>
    <% } %>

</div>
</section>

<%- include('../mikansei/footer') %>
