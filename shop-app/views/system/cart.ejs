<%- include('../mikansei/header') %>

<!-- ============================================================ -->
<!--  カート確認・購入 — 完成版のお店                            -->
<!-- ============================================================ -->
<section class="py-4">
<div class="container mt-3">

    <h2 class="mb-4"><i class="bi bi-cart me-2"></i>ショッピングカート</h2>

    <!-- エラーメッセージ（在庫不足など） -->
    <% if (errorMsg) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ <%= errorMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (cartlist.length === 0) { %>
    <!-- カートが空 -->
    <div class="card text-center p-5 shadow-sm">
        <div class="card-body">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">カートは空です</h4>
            <a href="/shop" class="btn btn-warning mt-2">
                <i class="bi bi-shop me-1"></i>買い物を続ける
            </a>
        </div>
    </div>
    <% } else { %>

    <!-- カート内容テーブル（共通パーツ：Step5 と同じものを使用） -->
    <%- include('../mikansei/cart_table', { cartlist: cartlist, total: total, removeurl: '/cart/remove' }) %>

    <!-- 購入ボタン（共通パーツ：Step4 と同じものを使用） -->
    <%- include('../mikansei/buy_button', { buyurl: '/buy', total: total }) %>
    <div class="text-center mt-2">
        <a href="/shop" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>買い物を続ける
        </a>
    </div>

    <% } %>

</div>
</section>

<%- include('../mikansei/footer') %>
