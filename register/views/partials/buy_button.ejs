<%
// ============================================================
//  購入ボタン（共通パーツ）
//  ★このファイルを直すと、Step4 と 本番ショップのカート(/cart) が
//    「両方同時に」変わります。
//
//  受け取る値：
//    buyUrl … 「購入する」の送信先（例 '/purchase' や '/buy'）
//    total  … 合計金額
// ============================================================
%>
<div class="text-center">
    <!-- 【課題4-C 穴埋め】「購入する」ボタンの送信先（行き先）を入れよう。
         1つ目の 'dummy' を buyUrl に書きかえてね。
         ヒント：送信先は buyUrl という箱に入っているよ（ページに合った行き先に自動でなる）。
                'dummy' のままだと、押しても買えない（404 エラー）よ。 -->
    <!-- 【課題4-D 穴埋め】ボタンの色を決めよう。2つ目の 'dummy' を btn-danger に書きかえてね。
         ヒント：btn-danger=赤 / btn-primary=青 / btn-success=緑。買うボタンは目立つ色がおすすめ。 -->
    <form action="<%= 'dummy' %>" method="POST">
        <button type="submit" class="btn <%= 'dummy' %> btn-lg px-5"
                onclick="return confirm('合計 <%= total.toLocaleString() %>円 で購入しますか？')">
            <i class="bi bi-bag-check me-2"></i>購入する（合計 <%= total.toLocaleString() %>円）
        </button>
    </form>
</div>
