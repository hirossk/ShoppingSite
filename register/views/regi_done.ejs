<%- include('partials/header') %>

<!-- ============================================================ -->
<!--  会計結果（おつり）画面                                        -->
<!-- ============================================================ -->
<section class="py-5">
<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow text-center">
                <div class="card-header bg-success text-white py-3">
                    <h3 class="m-0"><i class="bi bi-check-circle me-2"></i>お会計ありがとうございました</h3>
                </div>
                <div class="card-body p-4">

                    <!-- おつりを大きく表示 -->
                    <p class="text-muted mb-1 fs-5">おつり</p>
                    <p class="display-2 fw-bold text-success mb-4">¥<%= sale.change.toLocaleString() %></p>

                    <div class="row text-center mb-4">
                        <div class="col">
                            <div class="text-muted small">合計</div>
                            <div class="fs-4 fw-bold">¥<%= sale.total.toLocaleString() %></div>
                        </div>
                        <div class="col border-start">
                            <div class="text-muted small">お預かり</div>
                            <div class="fs-4 fw-bold">¥<%= sale.paid.toLocaleString() %></div>
                        </div>
                    </div>

                    <!-- 買ったものの明細 -->
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr><th>商品</th><th class="text-center">個数</th><th class="text-end">小計</th></tr>
                        </thead>
                        <tbody>
                            <% sale.items.forEach(function(it) { %>
                            <tr>
                                <td class="text-start"><%= it.name %></td>
                                <td class="text-center"><%= it.count %></td>
                                <td class="text-end">¥<%= (it.price * it.count).toLocaleString() %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>

                    <a href="/" class="btn btn-primary btn-lg w-100 mt-3 py-3 fs-4">
                        <i class="bi bi-arrow-right-circle me-2"></i>次のお客様へ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
</section>

<%- include('partials/footer') %>
